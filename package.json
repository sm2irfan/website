{
  "name": "-scaffold-tmp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://sm2irfan.github.io/website/newdesign",
  "scripts": {
    "dev": "vite",
    "dev:newdesign": "vite --base=/website/newdesign/",
    "build": "tsc -b && vite build",
    "build:newdesign": "tsc -b && vite build --base=/website/newdesign/",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "predeploy:newdesign": "npm run build:newdesign",
    "deploy:newdesign": "gh-pages -d dist --dest newdesign --add"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.5"
  }
}
